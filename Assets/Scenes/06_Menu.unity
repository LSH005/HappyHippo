--- !u!114 &1195767606
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1195767604}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uBA54\uB274 \uC52C / \uC791\uC5C5\uC790 : \uC9C4\uC8FC\uC601\n\n\uC791\uC5C5
    \uB0B4\uC6A9 : \uBA54\uB274 \uC52C\uC744 \uAD6C\uC131\uD588\uC2B5\uB2C8\uB2E4.\n\uC6B0\uC0C1\uB2E8\uC758
    \uBA54\uB274 \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uD328\uB110\uC774 \uC2AC\uB77C\uC774\uB4DC
    \uD31D\uC5C5\uC73C\uB85C \uBCF4\uC5EC\uC9D1\uB2C8\uB2E4.\n\uBCF4\uB77C\uC0C9
    \uC810 \uC774\uBBF8\uC9C0\uB294 \uC54C\uB9BC \uC774\uBBF8\uC9C0\uB85C \uD55C
    \uBC88 \uD074\uB9AD\uD574\uC11C \uB4E4\uC5B4\uAC08 \uACBD\uC6B0 \uC0AD\uC81C\uB429\uB2C8\uB2E4.\n(\uC52C
    \uC785\uC7A5\uC2DC Dot \uD65C\uC131\uD654 \uD638\uCD9C)\nHover\uD560 \uACBD\uC6B0
    DOScale\uC744 \uD1B5\uD574 \uD3EC\uCEE4\uC2A4 \uB41C \uBC84\uD2BC\uC744 \uD655\uC778\uD560
    \uC218 \uC788\uB3C4\uB85D \uAD6C\uC131\uD558\uC600\uC2B5\uB2C8\uB2E4.\n\uD328\uB110\uC758
    \uCD5C\uC0C1\uB2E8 \uAD11\uACE0\uCC3D\uC740 \uD638\uBC84\uB9C1 \uD560 \uACBD\uC6B0
    \uCE90\uB9AD\uD130\uC640 \uD14D\uC2A4\uD2B8\uAC00 \uC6C0\uC9C1\uC774\uB294 \uC5F0\uCD9C\uC744
    DOAnchorPos\uB97C \uD1B5\uD558\uC5EC \uCD94\uAC00\uD558\uC600\uC2B5\uB2C8\uB2E4.
    \uAD11\uACE0\uBB38\uAD6C\uAC00 \uD56D\uC2DC \uBCF4\uC5EC\uC57C\uD558\uAE30 \uB54C\uBB38\uC5D0
    \uB9C8\uC6B0\uC2A4\uB97C \uB5BC\uB3C4 originalPos\uB97C \uC720\uC9C0\uD558\uB418
    \uD638\uBC84\uB9C1\uC911\uC5D0\uB9CC \uC5F0\uCD9C\uC774 \uC7AC\uC0DD\uB418\uB3C4\uB85D
    \uD558\uC600\uC2B5\uB2C8\uB2E4. \n\n\uD658\uACBD \uC124\uC815 \uBC84\uD2BC\uACFC
    \uAC19\uC774 \uC874\uC7AC\uD558\uB294 \uC52C\uC774\uB77C\uBA74 \uBC84\uD2BC \uD074\uB9AD
    \uC2DC \uC52C \uC804\uD658\uC774 \uB418\uB3C4\uB85D \uD568\uC218\uB97C \uC5F0\uACB0\uD574\uB450\uC5C8\uC2B5\uB2C8\uB2E4.
    \uAE30\uD0C0 \uBC84\uD2BC\uB4E4\uC740 dot \uC81C\uAC70\uB9CC \uC791\uB3D9\uD558\uBA70
    \uB530\uB85C \uC52C \uC804\uD658\uC774\uB098 \uD31D\uC5C5\uC774 \uC791\uB3D9\uD558\uC9C0\uB294
    \uC54A\uC2B5\uB2C8\uB2E4.\n\uCD5C\uB300\uD55C \uAC01 \uAE30\uB2A5\uC744 \uC7AC\uD65C\uC6A9\uD560
    \uC218 \uC788\uB3C4\uB85D \uC790\uC8FC \uC0AC\uC6A9\uD558\uB294 \uD398\uC774\uB4DC\uB098
    \uC2A4\uCF00\uC77C \uB4F1\uC758 \uB450\uD2B8\uC708 \uAE30\uB2A5\uC744 MyTween\uC774\uB77C\uB294
    \uC2A4\uD0DC\uD2F1 \uD074\uB798\uC2A4\uC5D0 \uBA54\uC11C\uB4DC\uB85C \uC815\uB9AC\uD55C
    \uB4A4, \uD544\uC694\uD55C \uACF3\uC5D0\uC11C \uD544\uC694\uD55C \uAE30\uB2A5\uB4E4\uC744
    \uD638\uCD9C\uD558\uC5EC \uC5F0\uCD9C\uC744 \uC313\uC544 \uC62C\uB9AC\uB294 \uD615\uC2DD\uC73C\uB85C
    \uAD6C\uC131\uD558\uC600\uC2B5\uB2C8\uB2E4."
